<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Passkey authentication</title>
  <link rel="stylesheet" type="text/css" href="/++resource++zmi/bootstrap-4.6.0/bootstrap.min.css" />
  <link rel="stylesheet" type="text/css" href="/++resource++zmi/fontawesome-free-5.15.2/css/all.css" />
  <link rel="stylesheet" type="text/css" href="/++resource++zmi/zmi_base.css" />
  <script src="/++resource++zmi/jquery-3.5.1.min.js"></script>
  <script src="/++resource++zmi/bootstrap-4.6.0/bootstrap.bundle.min.js"></script>
  <script src="/++resource++zmi/zmi_base.js"></script>
  <style>
    button.btn {
      width: 6rem;
    }
  </style>
</head>
<body>
  <main class="container">
    <h1>Passkey authentication <code id="user" tal:content="python:request.get('AUTHENTICATED_USER', '')">user</code></h1>
    <p>To register a passkey, first sign in using your existing account.</p>
    <button class="btn btn-primary d-inline mb-2 mr-2" id="register" type="button" title="Register a passkey">Register</button>
    <button class="btn btn-danger d-inline mb-2 mr-2" id="remove" type="button" title="Remove all my passkeys">Remove</button>
    <form class="d-inline form-inline" id="login">
      <button class="btn btn-success mb-2" type="submit" title="Sign in with a passkey">Sign in</button>
      <input placeholder="User ID" class="form-control mb-2 mr-sm-2" id="user-id" name="user_id" autocomplete="username webauthn" required="required" />
    </form>
    <pre class="alert alert-info d-none mx-0 my-5" id="message" role="status" aria-live="polite"></pre>
  </main>
  <script>
    // JavaScript code for handling WebAuthn login and registration
    //<!--
    const message = document.getElementById("message");
    const fromBase64 = value => {
      const base64 = value.replace(/-/g, "+").replace(/_/g, "/");
      return Uint8Array.from(atob(base64.padEnd(Math.ceil(base64.length / 4) * 4, "=")), c => c.charCodeAt(0));
    };
    const toBase64 = value => {
      const bytes = new Uint8Array(value);
      return btoa(Array.from(bytes, byte => String.fromCharCode(byte)).join(""))
        .replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
    };
    async function post(endpoint, data) {
      const response = await fetch(new URL(endpoint, window.location.href), {
        method: "POST", credentials: "same-origin",
        headers: {"Content-Type": "application/json"}, body: JSON.stringify(data)
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || "Request failed.");
      return result;
    }
    function decodeOptions(options, registration) {
      options.challenge = fromBase64(options.challenge);
      if (registration) options.user.id = fromBase64(options.user.id);
      const key = registration ? "excludeCredentials" : "allowCredentials";
      for (const credential of options[key] || []) credential.id = fromBase64(credential.id);
      return options;
    }
    function encodeCredential(credential) {
      const response = credential.response;
      const result = {
        id: credential.id, rawId: toBase64(credential.rawId), type: credential.type,
        response: {clientDataJSON: toBase64(response.clientDataJSON)},
        clientExtensionResults: credential.getClientExtensionResults()
      };
      if (response.attestationObject) {
        result.response.attestationObject = toBase64(response.attestationObject);
        if (response.getTransports) result.response.transports = response.getTransports();
      } else {
        result.response.authenticatorData = toBase64(response.authenticatorData);
        result.response.signature = toBase64(response.signature);
        if (response.userHandle) result.response.userHandle = toBase64(response.userHandle);
      }
      return result;
    }
    async function run(registration) {
      message.textContent = "";
      try {
        if (!window.PublicKeyCredential) throw new Error("WebAuthn is unavailable in this browser.");
        const prefix = registration ? "registration" : "authentication";
        const data = registration ? {} : {user_id: document.getElementById("user-id").value};
        const options = decodeOptions(await post(prefix + "_options", data), registration);
        const credential = registration
          ? await navigator.credentials.create({publicKey: options})
          : await navigator.credentials.get({publicKey: options});
        if (!credential) throw new Error("No passkey was returned.");
        await post(prefix + "_finish", encodeCredential(credential));
        message.textContent = registration ? "Passkey registered." : "Signed in.";
        document.getElementById("user").textContent = document.getElementById("user-id").value;
      } catch (error) {
        message.textContent = error.message || "Passkey operation failed.";
      }
      // display #message
      document.getElementById("message").classList.remove("d-none");
    }
    document.getElementById("register").addEventListener("click", () => run(true));
    document.getElementById("remove").addEventListener("click", async () => {
      if (!confirm("Remove all your passkeys and sign out passkey sessions?")) return;
      try {
        await post("remove_passkeys", {});
        message.textContent = "Passkeys removed.";
      } catch (error) {
        message.textContent = error.message || "Could not remove passkeys.";
      }
    });
    document.getElementById("login").addEventListener("submit", event => {
      event.preventDefault();
      run(false);
    });
  //-->
  </script>
</body>
</html>
