<tal:block tal:replace="structure here/manage_page_header">Header</tal:block>
<main class="container-fluid">
  <h2>Add a ZMS WebAuthn Plugin</h2>
  <form action="addZMSPASWebauthn" method="post">
    <div class="form-group">
      <label for="id">Id</label>
      <input id="id" name="id" class="form-control" value="webauthn" required="required" />
    </div>
    <div class="form-group">
      <label for="title">Title</label>
      <input id="title" name="title" class="form-control" value="WebAuthn" />
    </div>
    <div class="form-group">
      <label for="rp_id">RP ID (domain, without scheme or port)</label>
      <input id="rp_id" name="rp_id" class="form-control" required="required" />
    </div>
    <div class="form-group">
      <label for="origin">Exact HTTPS origin (including port if applicable)</label>
      <input id="origin" name="origin" type="url" class="form-control" required="required" />
    </div>
    <input class="btn btn-primary" type="submit" value="Add" />
  </form>
</main>
<tal:block tal:replace="structure here/manage_page_footer">Footer</tal:block>
